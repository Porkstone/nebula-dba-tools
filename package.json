{
  "name": "nebula-dba-tools",
  "private": true,
  "version": "0.1.0",
  "description": "Local SQL Server backup and restore workspace",
  "author": "Nebula",
  "license": "MIT",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env NEBULA_DEV_URL=http://127.0.0.1:5173 node scripts/start-electron.cjs\"",
    "dev:web": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "node scripts/start-electron.cjs",
    "lint": "eslint src",
    "format": "prettier --write src electron tests scripts docs/plans *.json *.ts *.js *.html README.md pnpm-workspace.yaml",
    "test": "node --test tests/*.test.cjs",
    "test:integration": "node tests/integration.cjs",
    "test:desktop": "pnpm build && node tests/desktop.cjs",
    "package": "pnpm build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.nebula.dba",
    "productName": "Nebula DBA",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "LICENSE",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Nebula-DBA-${version}.exe"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
